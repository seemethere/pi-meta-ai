{
  "name": "pi-meta-ai",
  "version": "0.1.2",
  "description": "Pi extension for Meta Model API (Muse Spark) via API key. Adds Meta provider with OpenAI Responses compatibility, tool calling, reasoning, and easy login.",
  "type": "module",
  "keywords": ["pi-package", "pi-extension", "meta", "model-api", "muse-spark", "llm", "ai"],
  "license": "MIT",
  "author": "Meta Model API Contributors",
  "homepage": "https://github.com/seemethere/pi-meta-ai#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/seemethere/pi-meta-ai.git"
  },
  "bugs": {
    "url": "https://github.com/seemethere/pi-meta-ai/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "extensions",
    "models.json.example",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "pi": {
    "extensions": ["./extensions/meta-model-api"]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.80.0",
    "@earendil-works/pi-coding-agent": "^0.80.0",
    "typescript": "^5.0.0"
  }
}
